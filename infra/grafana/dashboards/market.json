      },
      {
        "name": "asset",
        "label": "Asset",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse"
        },
        "query": "SELECT DISTINCT asset FROM flux.bars_1m ORDER BY asset",
        "definition": "SELECT DISTINCT asset FROM flux.bars_1m ORDER BY asset",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "BTC",
          "value": "BTC"
        }
