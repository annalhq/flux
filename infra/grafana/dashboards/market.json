  "annotations": {
    "list": [
      {
        "name": "Double bottoms",
        "enable": true,
        "iconColor": "purple",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse"
        },
        "target": {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT pattern_start AS time, confirmed_at AS timeEnd, concat('Double bottom ', exchange, ' ', asset, ': lows ', toString(first_low), ' / ', toString(second_low), ', neckline ', toString(neckline)) AS text FROM flux.double_bottoms FINAL WHERE exchange='$exchange' AND asset='$asset' AND $__timeFilter(confirmed_at)",
          "refId": "A"
        }
      }
    ]
  },
