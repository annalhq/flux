        "query": "SELECT DISTINCT exchange FROM flux.bars_1m ORDER BY exchange",
        "definition": "SELECT DISTINCT exchange FROM flux.bars_1m ORDER BY exchange",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "binance",
          "value": "binance"
