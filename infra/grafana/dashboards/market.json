    {
      "id": 17,
      "type": "table",
      "title": "Hourly runs",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT interval_start AS hour, status, windows_total AS windows, windows_match AS exact, windows_late AS late, windows_missing + windows_exceed + windows_mismatch AS broken, duplicate_events AS duplicates, round(completeness_pct, 4) AS completeness_pct FROM flux.recon_runs FINAL ORDER BY interval_start DESC LIMIT 24",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "minWidth": 50,
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "OK": {
                        "color": "green",
                        "index": 0
                      },
                      "LATE_ONLY": {
                        "color": "yellow",
                        "index": 1
                      },
                      "FAILED": {
                        "color": "red",
                        "index": 2
                      },
                      "NO_DATA": {
                        "color": "text",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(time|hour|confirmed)$"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          },
          {
            "matcher": {
