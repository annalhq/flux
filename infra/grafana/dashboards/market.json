          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT toFloat64(close_price) FROM flux.bars_1m FINAL WHERE exchange='$exchange' AND asset='$asset' ORDER BY window_start DESC LIMIT 1",
          "refId": "A"
