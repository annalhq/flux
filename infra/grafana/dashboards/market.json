          "format": 1,
          "rawSql": "SELECT toFloat64(sum(notional)) / toFloat64(sum(volume)) FROM flux.bars_1m FINAL WHERE exchange='$exchange' AND asset='$asset' AND window_start >= (SELECT max(window_start) FROM flux.bars_1m) - INTERVAL 1 HOUR",
