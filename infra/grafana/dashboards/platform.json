      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - max by (exchange) (flux_producer_last_event_timestamp_seconds)",
          "legendFormat": "{{exchange}}",
          "refId": "A"
