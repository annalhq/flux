<clickhouse>
    <users>
        <!-- Application user for bootstrap, Grafana and Airflow. -->
        <flux>
            <password from_env="FLUX_CH_USER_PASSWORD"/>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
            <named_collection_control>1</named_collection_control>
        </flux>
        <!-- Passwordless default user stays local to the container (clickhouse-client, healthcheck). -->
        <default>
            <networks replace="replace">
                <ip>::1</ip>
                <ip>127.0.0.1</ip>
            </networks>
        </default>
    </users>
</clickhouse>
