# Flux configuration. Copy to .env (`make env`) and adjust. Nothing here is a real secret.

# --- Kafka ---
# Generated once with `kafka-storage.sh random-uuid`; must stay stable for the life of the volumes.
KAFKA_CLUSTER_ID=JgS78fbISpSoWBCbS2lFng
KAFKA_BOOTSTRAP=kafka-1:9092,kafka-2:9092,kafka-3:9092          # in-network
KAFKA_BOOTSTRAP_HOST=localhost:29092,localhost:29093,localhost:29094
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# --- Producers ---
PRODUCER_MODE=synthetic               # live | synthetic
ASSETS=BTC,ETH,SOL
SYNTH_SEED=42
SYNTH_BACKFILL_MINUTES=120            # start event clock at now - 120 min
SYNTH_SPEED=120                       # sim seconds per wall second until caught up
SYNTH_TPS=5                           # trades / sim-second / asset / exchange
SYNTH_LATE_RATIO=0.001                # fraction of trades emitted 30 s late (shows up as LATE_DROPS)
SYNTH_DUP_RATIO=0.0005                # fraction of Coinbase trades re-sent (shows up as duplicates)
PRODUCER_METRICS_PORT=8000

# --- Flink jobs ---
SIGNAL_CHECKPOINT_INTERVAL=10 s
LAKE_CHECKPOINT_INTERVAL=60 s
WATERMARK_DELAY_SECONDS=5
WHALE_MIN_NOTIONAL=250000             # quote currency (USD/USDT)
DB_DIP_TOLERANCE=0.005                # second dip within 0.5 % of the first
DB_MIN_DEPTH=0.01                     # neckline at least 1 % above the first dip
ARB_SIGNAL_BPS=10                     # documentation only; the threshold lives in the ClickHouse view

# --- Lake ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
ICEBERG_REST_URI=http://nessie:19120/iceberg
ICEBERG_WAREHOUSE=warehouse

# --- Postgres (Airflow metadata + Nessie version store) ---
POSTGRES_USER=flux
POSTGRES_PASSWORD=flux

# --- ClickHouse ---
CLICKHOUSE_USER=flux
CLICKHOUSE_PASSWORD=flux

# --- UIs ---
GRAFANA_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_PASSWORD=admin
